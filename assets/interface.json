{
    "interface_version": 2,
    "languages": {
        "zh_cn": "locales/interface/zh_cn.json",
        "en_us": "locales/interface/en_us.json"
    },
    "name": "MDA",
    "icon": "locales/MDA-Tiny.png",
    "mirrorchyan_rid": "MDA",
    "mirrorchyan_multiplatform": true,
    "github": "https://github.com/1204244136/MDA",
    "version": "0.1.0",
    "contact": "$contact.file",
    "license": "locales/LICENSE_SHORT.md",
    "welcome": "$welcome.file",
    "description": "$description.file",
    "controller": [
        {
            "name": "Win32-Window",
            "label": "$controller.Win32-Window.label",
            "description": "$controller.Win32-Window.description",
            "type": "Win32",
            "permission_required": true,
            "win32": {
                "class_regex": "UnityWndClass",
                "window_regex": "(NIKKE|勝利女神：妮姬)",
                "screencap": "Background",
                "mouse": "SendMessageWithCursorPos",
                "keyboard": "PostMessage"
            }
        },
        {
            "name": "Win32-Window-Background",
            "label": "$controller.Win32-Window-Background.label",
            "description": "$controller.Win32-Window-Background.description",
            "type": "Win32",
            "permission_required": true,
            "win32": {
                "class_regex": "UnityWndClass",
                "window_regex": "(NIKKE|勝利女神：妮姬)",
                "screencap": "PrintWindow",
                "mouse": "SendMessageWithWindowPos",
                "keyboard": "PostMessage"
            }
        },
        {
            "name": "Win32-Front",
            "label": "$controller.Win32-Front.label",
            "description": "$controller.Win32-Front.description",
            "type": "Win32",
            "permission_required": true,
            "win32": {
                "class_regex": "UnityWndClass",
                "window_regex": "(NIKKE|勝利女神：妮姬)",
                "screencap": "ScreenDC",
                "mouse": "Seize",
                "keyboard": "Seize"
            }
        },
        {
            "name": "AAA",
            "label": "$controller.AAA.label",
            "description": "$controller.AAA.description",
            "type": "Win32",
            "permission_required": true,
            "win32": {
                "class_regex": "UnityWndClass",
                "window_regex": "(NIKKE|勝利女神：妮姬)",
                "screencap": "ScreenDC",
                "mouse": "Interception",
                "keyboard": "Seize"
            }
        },
        {
            "name": "ADB",
            "label": "$controller.ADB.label",
            "description": "$controller.ADB.description",
            "type": "Adb"
        }
    ],
    "resource": [
        {
            "name": "国际服",
            "path": [
                "./resource"
            ]
        }
    ],
    "agent": {
        "child_exec": "agent/go-service",
        "child_args": []
    },
    "group": [
        {
            "name": "preprocess",
            "label": "$group.preprocess.label",
            "description": "$group.preprocess.description"
        },
        {
            "name": "daily",
            "label": "$group.daily.label",
            "description": "$group.daily.description"
        },
        {
            "name": "periodic",
            "label": "$group.periodic.label",
